# Copy to .env.local for local development. All variables are optional.

# Canonical site origin used for metadata, sitemap and structured data.
# On Vercel this falls back to VERCEL_PROJECT_PRODUCTION_URL automatically.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Stripe Checkout in TEST mode (server-side only). Must start with sk_test_.
# When unset, checkout uses the clearly-labelled simulated provider.
STRIPE_SECRET_KEY=kbknb
